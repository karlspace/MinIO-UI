# Admin Console for MinIO - Environment Configuration
# Copy to .env and adjust values

# === Required ===

# MinIO Server Endpoint
CONSOLE_MINIO_SERVER=http://minio:9000

# MinIO Server Region
CONSOLE_MINIO_REGION=us-east-1

# === Optional ===

# JWT encryption secrets (auto-generated if not set)
# WARNING: Sessions lost on restart without these!
# Generate with: openssl rand -base64 32
# CONSOLE_PBKDF_PASSPHRASE=
# CONSOLE_PBKDF_SALT=

# Console HTTP Port (default: 9090)
# CONSOLE_PORT=9090

# Debug logging (0=off, 1=5xx, 2=4xx+5xx, 3=all, 4-6=detailed)
# CONSOLE_DEBUG_LOGLEVEL=0

# === MinIO Server (for development) ===

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
